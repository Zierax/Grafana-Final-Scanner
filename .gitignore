# --- Python ---
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.manifest
*.spec

# --- Virtual Environments ---
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# --- Packaging ---
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt

# --- Testing & Coverage ---
.pytest_cache/
pytest_cache/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
*.cover
.hypothesis/
coverage.xml
nosetests.xml

# --- Linting & Type Checking ---
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- Environment & Secrets ---
.env
.envrc
*.log
local_settings.py

# --- Project-specific ---
# Vulnerability database (contains sensitive scan data)
vulndb.json
*.vulndb.json

# Scan output reports
*.html
*.csv
*.json
!requirements.txt
!package.json

# Docker
.dockerignore

# Jupyter
.ipynb_checkpoints

# Editor temp files
*.bak
*.swp
*.swo
*~

# Audit report (not for version control)
audit.txt
